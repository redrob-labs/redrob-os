[Unit]
Description=HAOS data partition
Wants=haos-expand.service
DefaultDependencies=no
After=haos-expand.service
Before=umount.target local-fs.target
Conflicts=umount.target
After=systemd-fsck@dev-disk-by\x2dlabel-redrob\x2ddata.service
Wants=systemd-fsck@dev-disk-by\x2dlabel-redrob\x2ddata.service systemd-growfs@mnt-data.service

[Mount]
What=/dev/disk/by-label/redrob-data
Where=/mnt/data
Type=ext4
Options=commit=30

[Install]
WantedBy=local-fs.target
