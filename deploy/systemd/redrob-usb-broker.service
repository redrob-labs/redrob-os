[Unit]
Description=Redrob USB Broker (default-deny USB admission, approval, read-only automount)
Documentation=https://github.com/redrob-labs/redrob-os
After=systemd-udevd.service mnt-data.mount redrob-firstboot.service
Wants=systemd-udevd.service
RequiresMountsFor=/mnt/data
Requires=redrob-firstboot.service
# Arm authorized_default=0 before the agent comes up, so nothing it does can race a device in.
Before=redrob-agent.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Root: writes /sys/bus/usb/.../authorized and mounts block devices. Capabilities are
# cut to what those two need; the socket is group redrob-broker for the agent.
User=root
Environment=RUST_LOG=info
ExecStart=/usr/bin/redrob-usb-broker --socket /run/redrob/usb.sock --policy /mnt/data/redrob/usb/policy.json --audit-dir /mnt/data/redrob/audit --media-dir /run/media/redrob
ExecStartPost=/bin/sh -c 'for i in 1 2 3 4 5; do [ -S /run/redrob/usb.sock ] && chgrp redrob-broker /run/redrob/usb.sock && exit 0; sleep 1; done; exit 1'
Restart=always
RestartSec=5
TimeoutStopSec=20
RuntimeDirectory=redrob media/redrob
RuntimeDirectoryPreserve=yes
ReadWritePaths=/mnt/data/redrob/usb /mnt/data/redrob/audit /sys/bus/usb /run/media/redrob
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
MemoryHigh=48M
MemoryMax=128M

[Install]
WantedBy=multi-user.target
