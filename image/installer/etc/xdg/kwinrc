# Redrob OS KWin defaults. Users override in ~/.config/kwinrc.

[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
# Windows-like title bar: nothing on the left, minimize / maximize / close on the right.
ButtonsOnLeft=
ButtonsOnRight=IAX
ShowToolTips=true

[MouseBindings]
# Double-click the title bar to maximize / restore.
CommandDoubleClick=Maximize
CommandActiveTitlebar1=Raise
CommandTitlebarWheel=Nothing

[Windows]
# Snap to screen edges like Windows (Win+Left/Right already quick-tiles).
ElectricBorders=0
ElectricBorderMaximize=true
ElectricBorderTiling=true

[Wayland]
# Input method on Wayland: KWin starts IBus itself through this desktop entry.
# Fedora's ibus packages do not install it (checked fc44 1.5.34), so the
# installer overlay ships it. Without it ibus-hangul is installed but never
# running, so 한/영 does nothing. Engines preloaded via dconf
# (/etc/dconf/db/local.d/10-redrob-ibus).
InputMethod=/usr/share/applications/org.freedesktop.IBus.Panel.Wayland.desktop
