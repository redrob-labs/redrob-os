[desktop/ibus/general]
preload-engines=['xkb:us::eng', 'hangul']
use-system-keyboard-layout=true
embed-preedit-text=true

[desktop/ibus/general/hotkey]
# 한/영 (Hangul key) or Shift+Space toggles between the two engines.
triggers=['<Super>space', 'Hangul', '<Shift>space']
