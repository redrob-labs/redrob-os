[Desktop Entry]
# Redrob OS: the input-method entry KWin launches on Wayland (kwinrc
# [Wayland] InputMethod=). Upstream ibus has this file as
# data/org.freedesktop.IBus.Panel.Wayland.desktop.in, but Fedora's ibus and
# ibus-wayland packages (1.5.34, fc44) do not install it, so we ship it.
# `--panel disable`: KWin and the Plasma keyboard applet are the panel;
# ibus-daemon still spawns /usr/libexec/ibus-wayland (text-input) because
# WAYLAND_DISPLAY is set. Copyright 2026 Janghoon Lee (Redrob) and contributors. Apache-2.0.
Name=IBus Wayland
Name[ko]=IBus 웨이랜드
Comment=IBus input method for Wayland sessions
Comment[ko]=웨이랜드 세션용 IBus 입력기
Exec=ibus-daemon -r --xim --panel disable
Icon=ibus-setup
Type=Application
NoDisplay=true
X-KDE-Wayland-VirtualKeyboard=true
