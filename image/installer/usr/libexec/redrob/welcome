#
# redrob-welcome: first-login dialog for Redrob OS.
#
# Started once per user by /etc/xdg/autostart/redrob-welcome.desktop. Shows a
# three-button kdialog (connect phone / install apps / later) and remembers the
# choice in ~/.config/redrob/welcomed so it never shows again for that user.
# No new runtime: bash + kdialog + notify-send, all part of the Plasma image.
#
# Language follows $LANG (ko_* -> Korean, anything else -> English).

set -u

marker_dir="${XDG_CONFIG_HOME:-$HOME/.config}/redrob"
marker="$marker_dir/welcomed"
[ -e "$marker" ] && exit 0

# The autostart entry runs in Plasma's late phase (X-KDE-autostart-phase=2),
# so the panel is already painted when the dialog appears; no sleep needed.
case "${LANG:-}" in
  ko*) KO=1 ;;
  *)   KO=0 ;;
esac

if [ "$KO" = 1 ]; then
  title="Redrob OS에 오신 것을 환영합니다"
  body="설정이 끝났습니다. 지금 무엇을 할까요?\n\n• 폰 연결 — 휴대폰 앱에서 QR 코드를 찍어 이 컴퓨터를 내 계정에 연결합니다.\n• 앱 설치 — Redrob Launcher에서 Browser, Office, Canvas, Code를 설치합니다.\n\n나중에 할 수도 있습니다. 두 메뉴는 시작 메뉴 → Redrob에 있습니다."
  b_pair="폰 연결"
  b_apps="앱 설치"
  b_later="나중에"
  pair_title="폰 연결"
  pair_missing="페어링 코드를 아직 만들지 못했습니다. 잠시 뒤 시작 메뉴 → Redrob → 폰 연결을 다시 열어 주세요."
  launcher_missing="Redrob Launcher가 이 이미지에 없습니다."
else
  title="Welcome to Redrob OS"
  body="Setup is complete. What would you like to do now?\n\n• Connect phone — scan a QR code with the Redrob phone app to link this computer to your account.\n• Install apps — open Redrob Launcher to install Browser, Office, Canvas and Code.\n\nYou can do both later from Start menu → Redrob."
  b_pair="Connect phone"
  b_apps="Install apps"
  b_later="Later"
  pair_title="Connect phone"
  pair_missing="The pairing code is not ready yet. Open Start menu → Redrob → Connect phone again in a moment."
  launcher_missing="Redrob Launcher is not installed in this image."
fi

mkdir -p "$marker_dir"

# kdialog exit codes: --yes-label 0, --no-label 1, --cancel-label 2.
kdialog --title "$title" \
  --yesnocancel "$(printf '%b' "$body")" \
  --yes-label "$b_pair" --no-label "$b_apps" --cancel-label "$b_later"
choice=$?

# Whatever they chose, do not show the dialog again for this user.
date -u +%Y-%m-%dT%H:%M:%SZ > "$marker"

show_pairing() {
  # Preferred: the agent's pairing tool renders the QR + code to stdout.
  if command -v redrob-pairing >/dev/null 2>&1; then
    out="$(redrob-pairing --stdout 2>/dev/null)"
    if [ -n "$out" ]; then
      kdialog --title "$pair_title" --textbox <(printf '%s\n' "$out") 640 520
      return
    fi
  fi
  # Fallback: machine-readable pairing state written at boot.
  for f in /run/redrob-pairing/pairing.json /var/lib/redrob/pairing; do
    if [ -r "$f" ]; then
      kdialog --title "$pair_title" --textbox "$f" 640 400
      return
    fi
  done
  kdialog --title "$pair_title" --sorry "$pair_missing"
}

case "$choice" in
  0) show_pairing ;;
  1)
    if command -v redrob-launcher >/dev/null 2>&1; then
      setsid -f redrob-launcher >/dev/null 2>&1 </dev/null
    else
      notify-send -a "Redrob OS" "$title" "$launcher_missing"
    fi
    ;;
  *) : ;;
esac
exit 0
