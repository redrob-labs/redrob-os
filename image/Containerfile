# Redrob OS -- bootable container image (bootc).
# Copyright 2026 Janghoon Lee (Redrob) and contributors. Apache-2.0.
#
# Build context is the REPOSITORY ROOT, not image/:
#   podman build -f image/Containerfile \
#     --build-arg BASE_IMAGE=$(. image/base.env; echo $BASE_IMAGE) \
#     --build-arg BASE_TAG=$(. image/base.env; echo $BASE_TAG) \
#     -t ghcr.io/redrob-labs/redrob-os:stable .
# CI reads image/base.env and passes BASE_IMAGE/BASE_TAG the same way (docs/image.md).
# The defaults below are a fallback for a bare `podman build`; image/base.env is the
# single source of truth and the two must be kept identical.
#
# Layer order (each overlay is COPYed onto / at its final absolute path):
#   1. base packages (dnf5, one transaction)            image/scripts, image/pins.env
#   2. pinned downloads: gVisor, Redrob Launcher, UI fonts  image/scripts/10-*,20-*,25-*
#   3. base-OS overlay                                   image/files/
#   4. branding overlay (os-release, logos, themes)      image/branding/   (branding agent)
#   5. agent overlay (units, sandbox, pairing)           image/agent/      (agent agent)
#   6. installer overlay (first-login hooks)             image/installer/  (installer agent)
#   7. cleanup + `ostree container commit` + `bootc container lint`
# Later overlays win on path collisions, so branding/agent/installer may override
# anything in image/files/.

ARG BASE_IMAGE="quay.io/fedora-ostree-desktops/base-atomic"
ARG BASE_TAG="44"

# Build-time context: everything the RUN steps need, bind-mounted read-only at /ctx
# so nothing from the build tree leaks into the final image.
FROM scratch AS ctx
COPY image/pins.env /pins.env
COPY image/scripts/ /scripts/

# Our own binaries, compiled from this repository (CI builds with the repo root as
# context, see docs/ci.md "Contract with the Containerfile"). Toolchain pinned to the
# same version the agent's upstream CI uses; bump together with agent/.
FROM docker.io/library/rust:1.98.0-bookworm AS redrob-build
RUN apt-get update && \
    apt-get install -y -q --no-install-recommends libudev-dev pkg-config libssl-dev \
        libseat-dev libinput-dev libgbm-dev libxkbcommon-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY agent/ /src/agent/
COPY modules/credential-broker/ /src/modules/credential-broker/
COPY modules/usb-broker/ /src/modules/usb-broker/
COPY tools/redrob-pairing/ /src/tools/redrob-pairing/
# Experiment: Redrob's own compositor + shell (Smithay), offered as the "Redrob" session.
COPY compositor/redrob-comp/ /src/compositor/redrob-comp/
RUN --mount=type=cache,dst=/usr/local/cargo/registry \
    --mount=type=cache,dst=/src/agent/target \
    --mount=type=cache,dst=/src/modules/credential-broker/broker/target \
    --mount=type=cache,dst=/src/modules/usb-broker/broker/target \
    --mount=type=cache,dst=/src/tools/redrob-pairing/target \
    --mount=type=cache,dst=/src/compositor/redrob-comp/target \
    set -eu && mkdir -p /out && \
    # the gateway embeds web/dist at compile time; the OS serves no web dashboard
    mkdir -p agent/web/dist && touch agent/web/dist/.gitkeep && \
    (cd agent && cargo build --release --locked --bin zeroclaw) && \
    install -m 0755 agent/target/release/zeroclaw /out/redrob-agent && \
    (cd modules/credential-broker/broker && cargo build --release --locked) && \
    install -m 0755 modules/credential-broker/broker/target/release/redrob-broker /out/ && \
    (cd modules/usb-broker/broker && cargo build --release --locked) && \
    install -m 0755 modules/usb-broker/broker/target/release/redrob-usb-broker /out/ && \
    (cd tools/redrob-pairing && cargo build --release --locked) && \
    install -m 0755 tools/redrob-pairing/target/release/redrob-pairing /out/ && \
    (cd compositor/redrob-comp && cargo build --release --locked) && \
    install -m 0755 compositor/redrob-comp/target/release/redrob-comp /out/

# NVIDIA kernel module, built against the exact kernel the base image ships (the
# akmods pattern Universal Blue uses; a bootc image cannot build modules on the
# device because /usr is read-only). x86_64 only: RPM Fusion has no aarch64 build.
# akmod-nvidia's %post starts an eager build as root, which akmodsbuild refuses
# inside a container build, so the scriptlets are skipped and the build is run
# explicitly as the `akmods` user. Output: /out/kmod-nvidia-<kver>-<ver>.rpm
# (empty on aarch64).
FROM ${BASE_IMAGE}:${BASE_TAG} AS akmods
ARG TARGETARCH
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    set -euo pipefail; mkdir -p /out; \
    if [ "${TARGETARCH:-amd64}" != "amd64" ]; then echo "akmods: skipped on ${TARGETARCH}"; exit 0; fi; \
    FEDORA="$(. /usr/lib/os-release && echo "${VERSION_ID}")"; \
    KVER="$(rpm -q kernel-core --qf '%{VERSION}-%{RELEASE}.%{ARCH}')"; \
    KV="$(rpm -q kernel-core --qf '%{VERSION}')"; KR="$(rpm -q kernel-core --qf '%{RELEASE}')"; \
    dnf5 -y install --setopt=install_weak_deps=False \
      "https://download1.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA}.noarch.rpm" \
      "https://download1.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA}.noarch.rpm" \
      || dnf5 -y install --setopt=install_weak_deps=False \
      "https://download2.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA}.noarch.rpm" \
      "https://download2.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA}.noarch.rpm"; \
    dnf5 -y install --setopt=install_weak_deps=False "kernel-devel-${KVER}" \
      || dnf5 -y install --setopt=install_weak_deps=False \
           "https://kojipkgs.fedoraproject.org/packages/kernel/${KV}/${KR}/x86_64/kernel-devel-${KVER}.rpm" \
           "https://kojipkgs.fedoraproject.org/packages/kernel/${KV}/${KR}/x86_64/kernel-devel-matched-${KVER}.rpm"; \
    dnf5 -y install --setopt=install_weak_deps=False akmods rpm-build; \
    dnf5 -y install --setopt=install_weak_deps=False --setopt=tsflags=noscripts akmod-nvidia; \
    chown akmods:akmods /out; install -d -o akmods -g akmods -m 0755 /tmp/akmods-build; \
    runuser -u akmods -- env TMPDIR=/tmp/akmods-build /usr/sbin/akmodsbuild \
      --target x86_64 --kernels "${KVER}" --outputdir /out /usr/src/akmods/nvidia-kmod.latest; \
    ls -l /out; test -n "$(ls /out/kmod-nvidia-*.rpm)"

FROM ${BASE_IMAGE}:${BASE_TAG}

ARG BASE_IMAGE
ARG BASE_TAG
ARG REDROB_OS_VERSION="dev"
ARG REDROB_OS_GIT_SHA="unknown"

LABEL org.opencontainers.image.title="Redrob OS" \
      org.opencontainers.image.description="Redrob OS is an agentic desktop that keeps itself updated and runs your AI agent in a sandbox" \
      org.opencontainers.image.vendor="Redrob" \
      org.opencontainers.image.url="https://github.com/redrob-labs/redrob-os" \
      org.opencontainers.image.source="https://github.com/redrob-labs/redrob-os" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="${REDROB_OS_VERSION}" \
      org.opencontainers.image.revision="${REDROB_OS_GIT_SHA}" \
      org.opencontainers.image.base.name="${BASE_IMAGE}:${BASE_TAG}" \
      ai.redrob.os.base="${BASE_IMAGE}:${BASE_TAG}"

# 1. Base packages -- a single dnf5 transaction so the swap (fedora-logos ->
#    generic-logos) and the installs resolve together. Weak deps off keeps the
#    image small; anything we actually want is named explicitly.
#    The base is Fedora Atomic's desktop-less `base-atomic` (kernel, bootc,
#    NetworkManager, PipeWire, Mesa, flatpak, bluez, cups, fwupd, plymouth).
#    There is no Plasma: the desktop is redrob-comp, greetd runs its login
#    screen. Listing a present package is a no-op, so the list below is the
#    full intent, not just the delta.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=cache,dst=/var/cache/rpm-ostree \
    --mount=type=tmpfs,dst=/tmp \
    dnf5 -y swap --setopt=install_weak_deps=False fedora-logos generic-logos && \
    dnf5 -y install --setopt=install_weak_deps=False \
        generic-logos \
        naver-nanum-fonts-all \
        greetd \
        zenity \
        wl-clipboard \
        xdg-desktop-portal-gtk \
        gsettings-desktop-schemas \
        adwaita-icon-theme \
        glibc-langpack-ko \
        glibc-langpack-en \
        xdg-user-dirs \
        xdg-utils \
        gnome-keyring \
        gnome-keyring-pam \
        udisks2 \
        gvfs \
        gvfs-mtp \
        upower \
        qt6-qtwayland \
        NetworkManager-wifi \
        wireplumber \
        system-config-printer \
        gnome-software \
        podman \
        podman-docker \
        catatonit \
        libnotify \
        openssl \
        curl \
        initial-setup \
        initial-setup-gui \
        plymouth-theme-script \
        greenboot \
        greenboot-default-health-checks \
        distrobox \
        flatpak \
        cups \
        system-config-printer-udev \
        sane-backends \
        sane-backends-drivers-scanners \
        fwupd \
        tuned-ppd \
        bluez \
        pipewire \
        libseat \
        zstd \
        unzip \
        tar

# 2. Pinned binaries (network downloads, checksum-verified against image/pins.env).
RUN --mount=type=bind,from=ctx,src=/,dst=/ctx,ro \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/scripts/10-pins.sh && \
    /ctx/scripts/20-launcher.sh && \
    /ctx/scripts/25-fonts.sh

# 2b. Hardware layer: RPM Fusion codecs, NVIDIA (userspace + the kernel module built
#     in the `akmods` stage, one transaction), fingerprint.
RUN --mount=type=bind,from=ctx,src=/,dst=/ctx,ro \
    --mount=type=bind,from=akmods,src=/out,dst=/akmods,ro \
    --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/scripts/15-hardware.sh && \
    /ctx/scripts/16-gaming.sh && \
    /ctx/scripts/18-debloat.sh

# 2c. Redrob session apps: current GTK4/libadwaita apps (follow the shell's
#     light/dark and accent through the portal and the Redrob GTK stylesheet),
#     and Fcitx 5 with Hangul for Korean input in the Redrob session (it speaks
#     the Wayland input-method protocol redrob-comp implements; ibus does not).
#     These are the desktop's apps.
RUN --mount=type=cache,dst=/var/cache/libdnf5 \
    --mount=type=tmpfs,dst=/tmp \
    dnf5 -y install --setopt=install_weak_deps=False \
        ptyxis \
        nautilus \
        gnome-text-editor \
        loupe \
        papers \
        gnome-calculator \
        fcitx5 \
        fcitx5-hangul \
        fcitx5-gtk \
        fcitx5-qt \
        fcitx5-configtool

# 3. Our binaries (agent, credential broker, USB broker, pairing) from the build stage.
COPY --from=redrob-build /out/ /usr/bin/

# 3b. Base-OS overlay: systemd presets/units, update timers, Flathub enablement,
#    container signature policy, sysctl, docs.
COPY image/files/ /

# 4-6. Sibling overlays. These directories are owned by other agents and may not
#      exist in every checkout; the parent merges them before CI builds.
#      /usr/lib/os-release lives in image/branding/ (branding agent) -- never here.
COPY image/branding/ /
COPY image/agent/ /
COPY image/installer/ /

# 6b. Boot splash: the branding overlay ships the `redrob` Plymouth theme, but the
#     initramfs is prebuilt in the base, so it has to be regenerated to carry it
#     (the same step Universal Blue runs after Plymouth changes). `ostree` must be
#     added explicitly: a --no-hostonly dracut inside a container does not detect an
#     ostree system and leaves the module out, and the installed system then fails
#     at "Switch Root" (seen on the v0.2.5 QEMU install).
RUN --mount=type=tmpfs,dst=/tmp \
    --mount=type=tmpfs,dst=/var/tmp \
    plymouth-set-default-theme redrob && \
    KVER="$(ls /usr/lib/modules | head -n1)" && \
    dracut --force --no-hostonly --reproducible --zstd \
           --add "plymouth ostree" \
           --kver "$KVER" "/usr/lib/modules/$KVER/initramfs.img"

# 6c. The task sandbox image is NOT logically bound (no /usr/lib/bootc/bound-images.d
#     entry): `bootc install` resolves bound images at install time, which breaks
#     bootc-image-builder's read-only store and any offline Anaconda install. The
#     quadlet unit image/agent/etc/containers/systemd/redrob-sandbox.image pulls it on
#     first boot instead; a failed pull only logs and the first task retries.

# 7. Cleanup to a shape bootc accepts (empty /var, /opt -> var/opt, no /tmp
#    leftovers), apply presets, commit, lint.
RUN --mount=type=bind,from=ctx,src=/,dst=/ctx,ro \
    /ctx/scripts/28-debrand.sh && \
    /ctx/scripts/30-cleanup.sh && \
    ostree container commit

RUN bootc container lint
