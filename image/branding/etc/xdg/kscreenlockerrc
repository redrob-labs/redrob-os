# Redrob OS: lock screen defaults. kscreenlocker keeps its own wallpaper
# setting, separate from the desktop and the login greeter; without this the
# v0.3.1 lock screen showed Plasma's stock image. Users override in
# ~/.config/kscreenlockerrc or System Settings > Screen Locking.

[Greeter]
WallpaperPlugin=org.kde.image

[Greeter][Wallpaper][org.kde.image][General]
Image=file:///usr/share/wallpapers/Redrob
FillMode=2
