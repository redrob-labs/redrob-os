#!/usr/bin/bash
# agent-sidebar -- toggle a right-edge dock showing the Redrob Agent's own web
# dashboard (http://127.0.0.1:42617, the [gateway] in /etc/redrob/agent.toml).
# No new app: it reuses the agent product's existing UI, opened in Redrob Browser
# app-mode; redrob-comp docks the window on the right edge (app id
# redrob-agent-sidebar). Toggling kills the window by its pidfile.
# Copyright 2026 Janghoon Lee (Redrob) and contributors. Apache-2.0.
set -euo pipefail

url="http://127.0.0.1:42617/"
run="${XDG_RUNTIME_DIR:-/tmp}/redrob"
mkdir -p "${run}"
pidf="${run}/agent-sidebar.pid"

# Already open -> close it (toggle).
if [ -f "${pidf}" ] && kill -0 "$(cat "${pidf}")" 2>/dev/null; then
  kill "$(cat "${pidf}")" 2>/dev/null || true
  rm -f "${pidf}"
  exit 0
fi

# Find a Chromium-class browser for --app mode. Redrob Browser (installed via the
# Launcher) is preferred; its binary may live in the user's home.
bro=""
for c in redrob-browser chromium chromium-browser google-chrome; do
  if command -v "${c}" >/dev/null 2>&1; then bro="${c}"; break; fi
done
for c in "${HOME}/.local/bin/redrob-browser" \
         "${XDG_DATA_HOME:-$HOME/.local/share}/redrob-launcher/apps/redrob-browser/bin/redrob-browser"; do
  if [ -z "${bro}" ] && [ -x "${c}" ]; then bro="${c}"; fi
done
if [ -z "${bro}" ]; then
  notify-send "Redrob Agent" "Redrob Browser is still installing — open the sidebar again shortly." 2>/dev/null || true
  exit 0
fi

"${bro}" --ozone-platform-hint=auto --app="${url}" --class=redrob-agent-sidebar --user-data-dir="${run}/agent-sidebar-profile" >/dev/null 2>&1 &
echo $! > "${pidf}"
