#!/usr/bin/bash
# style-chooser -- first login: ask whether this is a macOS-style or a
# Windows-style user, then apply the matching desktop. macOS = top menu bar +
# floating dock + window buttons on the LEFT. Windows = bottom taskbar + start
# menu + buttons on the RIGHT. Runs once (marker in XDG_STATE); if the dialog is
# cancelled or unavailable it keeps the safe Windows default.
# Copyright 2026 Janghoon Lee (Redrob) and contributors. Apache-2.0.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/redrob"
mkdir -p "${state}"
marker="${state}/desktop-style"
[ -e "${marker}" ] && exit 0

lay=/usr/share/redrob/layouts
qd="$(command -v qdbus6 || command -v qdbus || true)"
REDROB_ACCENT="43,82,255"   # Redrob Blue #2B52FF

apply_layout() { # $1 = mac|windows
  [ -n "${qd}" ] || return 0
  "${qd}" org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$(cat "${lay}/$1.js")" >/dev/null 2>&1 || true
}
kw() { kwriteconfig6 --file "$1" --group "$2" --key "$3" "$4" 2>/dev/null || true; }
set_buttons() { # $1 = left-codes  $2 = right-codes
  kw kwinrc org.kde.kdecoration2 ButtonsOnLeft "$1"
  kw kwinrc org.kde.kdecoration2 ButtonsOnRight "$2"
}
kwin_reconfigure() { [ -n "${qd}" ] && "${qd}" org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true; }

apply_mac_theme() {
  # Real macOS look from WhiteSur (baked by 26-mac-theme.sh), tinted to Redrob.
  if command -v plasma-apply-lookandfeel >/dev/null 2>&1; then
    plasma-apply-lookandfeel -a com.github.vinceliuice.WhiteSur-dark >/dev/null 2>&1 || true
  fi
  # Big Sur icons + Aurorae traffic-light decoration on the LEFT.
  kw kdeglobals Icons Theme WhiteSur
  kw kwinrc org.kde.kdecoration2 library org.kde.kwin.aurorae
  kw kwinrc org.kde.kdecoration2 theme __aurorae__svg__WhiteSur
  set_buttons "XIA" ""
  # Redrob tint: accent blue over the WhiteSur base.
  kw kdeglobals General AccentColor "${REDROB_ACCENT}"
}

choice="windows"
if command -v kdialog >/dev/null 2>&1; then
  choice="$(kdialog --title "Redrob OS" \
    --menu "데스크톱 스타일을 고르세요 · Choose your desktop style" \
    mac "macOS 스타일 — 상단 메뉴 막대 + 하단 도크 + 신호등 창 버튼" \
    windows "Windows 스타일 — 하단 작업 표시줄 + 시작 메뉴" 2>/dev/null)" || choice="windows"
fi

case "${choice}" in
  mac)
    apply_mac_theme
    apply_layout mac            # top bar + floating dock + Redrob wallpaper
    kwin_reconfigure
    echo "mac" > "${marker}" ;;
  *)
    # Stock Breeze, Windows shape: buttons on the right, default decoration/icons.
    kw kwinrc org.kde.kdecoration2 library org.kde.kwin.aurorae
    kw kwinrc org.kde.kdecoration2 theme __aurorae__svg__breeze
    kw kwinrc org.kde.kdecoration2 library org.kde.breeze
    kw kdeglobals General AccentColor "${REDROB_ACCENT}"
    set_buttons "" "IAX"
    apply_layout windows        # bottom taskbar + start menu + Redrob wallpaper
    kwin_reconfigure
    echo "windows" > "${marker}" ;;
esac
