#!/usr/bin/bash
# style-chooser -- first login: ask macOS-style or Windows-style, then apply the
# matching desktop. macOS = WhiteSur look (top bar + floating dock, traffic-light
# buttons on the LEFT). Windows = Win11OS look (bottom taskbar + start, buttons on
# the RIGHT). BOTH are forced to Redrob branding: Redrob wallpaper, Redrob splash,
# Redrob accent (#2B52FF), Redrob logo/app icons -- only the window decoration,
# panel style and colour scheme come from upstream. Runs once (marker in
# XDG_STATE); a cancelled/unavailable dialog keeps the safe Windows default.
# Copyright 2026 Janghoon Lee (Redrob) and contributors. Apache-2.0.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/redrob"
mkdir -p "${state}"
marker="${state}/desktop-style"
[ -e "${marker}" ] && exit 0

lay=/usr/share/redrob/layouts
qd="$(command -v qdbus6 || command -v qdbus || true)"
REDROB_ACCENT="43,82,255"            # Redrob Blue #2B52FF
REDROB_SPLASH="ai.redrob.desktop"    # our KSplash (Redrob lockup)

kw() { kwriteconfig6 --file "$1" --group "$2" --key "$3" "$4" 2>/dev/null || true; }

# apply_style  LNF  AURORAE_THEME  ICON_THEME  BTN_LEFT  BTN_RIGHT  LAYOUT
apply_style() {
  local lnf="$1" aurorae="$2" icons="$3" left="$4" right="$5" layout="$6"

  # 1. Upstream LOOK (decoration/panel/colour) via the global theme.
  command -v plasma-apply-lookandfeel >/dev/null 2>&1 \
    && plasma-apply-lookandfeel -a "${lnf}" >/dev/null 2>&1 || true

  # 2. Window decoration: Aurorae theme + button sides.
  kw kwinrc org.kde.kdecoration2 library org.kde.kwin.aurorae
  kw kwinrc org.kde.kdecoration2 theme "${aurorae}"
  kw kwinrc org.kde.kdecoration2 ButtonsOnLeft "${left}"
  kw kwinrc org.kde.kdecoration2 ButtonsOnRight "${right}"

  # 3. Redrob branding FORCED over the upstream theme.
  kw kdeglobals Icons Theme "${icons}"            # generic icons themed; our app/logo
                                                  # marks win via hicolor fallback
  kw kdeglobals General AccentColor "${REDROB_ACCENT}"
  kw ksplashrc KSplash Theme "${REDROB_SPLASH}"
  kw ksplashrc KSplash Engine KSplashQML

  # 4. Panels + Redrob wallpaper (the layout script sets the wallpaper itself).
  [ -n "${qd}" ] && "${qd}" org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript "$(cat "${lay}/${layout}.js")" >/dev/null 2>&1 || true

  # 5. Apply the kwin changes.
  [ -n "${qd}" ] && "${qd}" org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
}

choice="windows"
if command -v kdialog >/dev/null 2>&1; then
  choice="$(kdialog --title "Redrob OS" \
    --menu "데스크톱 스타일을 고르세요 · Choose your desktop style" \
    mac "macOS 스타일 — 상단 메뉴 막대 + 하단 도크 + 신호등 창 버튼" \
    windows "Windows 스타일 — 하단 작업 표시줄 + 시작 메뉴" 2>/dev/null)" || choice="windows"
fi

case "${choice}" in
  mac)
    apply_style com.github.vinceliuice.WhiteSur-dark __aurorae__svg__WhiteSur WhiteSur XIA "" mac
    echo "mac" > "${marker}" ;;
  *)
    apply_style com.github.yeyushengfan258.Win11OS-dark __aurorae__svg__Win11OS-dark Win11 "" IAX windows
    echo "windows" > "${marker}" ;;
esac
