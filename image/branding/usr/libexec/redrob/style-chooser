#!/usr/bin/bash
# style-chooser -- first login: ask macOS-style or Windows-style, then apply the
# whole matching look and make it stick.
#
# Why every component is written explicitly (not just `plasma-apply-lookandfeel`):
# on this Kinoite base `plasma-apply-lookandfeel -a <pkg>` does NOT reliably
# apply the colour scheme, Plasma style, widget style, decoration or icons
# (verified on a v0.5.4 install -- widgetStyle stayed empty, colours stayed the
# pre-chooser default). So we run it as a best-effort first pass and then write
# EACH component with kwriteconfig6, which is deterministic. The widget style is
# the load-bearing one: without widgetStyle=kvantum* the window interiors stay
# Breeze and the desktop is not really macOS/Windows.
#
# D-Bus tool: this base ships `qdbus-qt6` (not `qdbus6`/`qdbus`), so the panel
# layout + kwin reconfigure were silently skipped before -- include qdbus-qt6.
#
# macOS = traffic-light buttons on the LEFT; Windows = buttons on the RIGHT. Both
# are forced to Redrob branding (wallpaper, splash, accent, logo/app icons); only
# the look (colours, panel/widget style, window decoration) comes from upstream.
# Runs once (marker in XDG_STATE); a cancelled/unavailable dialog keeps Windows.
# Copyright 2026 Janghoon Lee (Redrob) and contributors. Apache-2.0.
set -euo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/redrob"
mkdir -p "${state}"
marker="${state}/desktop-style"
[ -e "${marker}" ] && exit 0

lay=/usr/share/redrob/layouts
qd="$(command -v qdbus6 || command -v qdbus || command -v qdbus-qt6 || true)"
REDROB_ACCENT="43,82,255"            # Redrob Blue #2B52FF
REDROB_SPLASH="ai.redrob.desktop"    # our KSplash (Redrob lockup)

kw() { kwriteconfig6 --file "$1" --group "$2" --key "$3" "$4" 2>/dev/null || true; }

# apply_style LNF AURORAE WIDGET COLORS PLASMA ICONS KVANTUM BTN_LEFT BTN_RIGHT LAYOUT
apply_style() {
  local lnf="$1" aurorae="$2" widget="$3" colors="$4" plasma="$5" icons="$6" \
        kvantum="$7" left="$8" right="$9" layout="${10}"

  # 1. Best-effort whole-theme apply (sets whatever it can); then we pin the rest.
  command -v plasma-apply-lookandfeel >/dev/null 2>&1 \
    && plasma-apply-lookandfeel -a "${lnf}" >/dev/null 2>&1 || true
  sleep 3

  # 2. Make the look STICK across logins: the chosen package is the default LnF.
  kw kdeglobals KDE LookAndFeelPackage "${lnf}"

  # 3. Every component written explicitly (deterministic, independent of #1).
  kw kdeglobals KDE widgetStyle "${widget}"        # Kvantum = the real mac/win widgets
  kw kdeglobals General ColorScheme "${colors}"
  kw plasmarc Theme name "${plasma}"               # Plasma panel/widget style
  kw kdeglobals Icons Theme "${icons}"             # generic icons; our marks win via hicolor
  kw kwinrc org.kde.kdecoration2 library org.kde.kwin.aurorae
  kw kwinrc org.kde.kdecoration2 theme "${aurorae}"
  kw kwinrc org.kde.kdecoration2 ButtonsOnLeft "${left}"
  kw kwinrc org.kde.kdecoration2 ButtonsOnRight "${right}"

  # 4. Kvantum engine theme (it reads its own config, not kdeglobals).
  mkdir -p "${HOME}/.config/Kvantum"
  printf '[General]\ntheme=%s\n' "${kvantum}" > "${HOME}/.config/Kvantum/kvantum.kvconfig"

  # 5. Redrob branding FORCED over the upstream theme.
  kw kdeglobals General AccentColor "${REDROB_ACCENT}"
  kw ksplashrc KSplash Theme "${REDROB_SPLASH}"
  kw ksplashrc KSplash Engine KSplashQML

  # 6. Panels + Redrob wallpaper via our layout (Redrob launchers in the dock).
  [ -n "${qd}" ] && "${qd}" org.kde.plasmashell /PlasmaShell \
    org.kde.PlasmaShell.evaluateScript "$(cat "${lay}/${layout}.js")" >/dev/null 2>&1 || true

  # 7. Re-decorate open windows with the Aurorae theme.
  [ -n "${qd}" ] && "${qd}" org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1 || true
}

choice="windows"
if command -v kdialog >/dev/null 2>&1; then
  choice="$(kdialog --title "Redrob OS" \
    --menu "데스크톱 스타일을 고르세요 · Choose your desktop style" \
    mac "macOS 스타일 — 상단 메뉴 막대 + 하단 도크 + 신호등 창 버튼" \
    windows "Windows 스타일 — 하단 작업 표시줄 + 시작 메뉴" 2>/dev/null)" || choice="windows"
fi

case "${choice}" in
  mac)
    apply_style com.github.vinceliuice.WhiteSur-dark __aurorae__svg__WhiteSur-dark \
      kvantum-dark WhiteSurDark WhiteSur-dark WhiteSur-dark WhiteSurDark XIA "" mac
    echo "mac" > "${marker}" ;;
  *)
    apply_style com.github.yeyushengfan258.Win11OS-dark __aurorae__svg__Win11OS-dark \
      kvantum Win11OSDark Win11OS-dark Win11 Win11OS-dark "" IAX windows
    echo "windows" > "${marker}" ;;
esac
