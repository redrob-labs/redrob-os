# Redrob task sandbox image (podman quadlet, .image): pre-pulls the container the
# agent runs tasks in (agent.toml [runtime.docker] image) into root podman
# storage, which is where podman.service -- the socket the agent's `docker run`
# reaches -- looks for it. Without this the first task waits on a registry pull.
#
# CI publishes ghcr.io/redrob-labs/redrob-os:sandbox next to the OS image
# (.github/workflows/build-image.yml, job `sandbox`). It is deliberately NOT a
# bootc logically-bound image: bootc resolves bound images at install time, which
# breaks bootc-image-builder and offline Anaconda installs. This unit pulls it on
# first boot; a failed pull only logs and the first task retries the pull.

[Unit]
Description=Redrob task sandbox image (pull into root podman storage)
After=network-online.target
Wants=network-online.target

[Image]
Image=ghcr.io/redrob-labs/redrob-os:sandbox
# Quadlet .image units pull with --policy missing by default: no re-pull on boot.

[Install]
WantedBy=multi-user.target
