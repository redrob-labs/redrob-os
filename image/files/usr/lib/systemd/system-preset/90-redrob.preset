# Redrob OS system-unit presets. Applied at build time by image/scripts/30-cleanup.sh
# (so the enablement symlinks ship in the image) and by systemd on first boot.
# Only `enable` lines are read by the build script; keep one unit per line.

# Atomic OS updates: fetch + stage daily (timer tuned in
# bootc-fetch-apply-updates.timer.d/redrob.conf), applied on the next reboot.
enable bootc-fetch-apply-updates.timer

# greenboot: boot health checks; a failing deployment is rolled back automatically.
enable greenboot-healthcheck.service
enable greenboot-loading-message.service
enable greenboot-task-runner.service
enable greenboot-status.service
enable greenboot-grub2-set-counter.service
enable greenboot-grub2-set-success.service
enable greenboot-rpm-ostree-grub2-check-fallback.service
enable redboot-task-runner.service
enable redboot-auto-reboot.service
enable redboot.target

# Flathub as the one app store (runs once, marker in /var/lib/redrob).
enable redrob-flathub.service

# Printing + firmware updates.
enable cups.socket
enable fwupd-refresh.timer
