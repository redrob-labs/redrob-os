# Redrob OS base image pin -- the ONE place the upstream base is named.
#
# Format: KEY=VALUE, one per line, shell- and GitHub-Actions-readable
# (`set -a; . image/base.env` or `cat image/base.env >> "$GITHUB_ENV"`).
# CI passes these to the build as --build-arg BASE_IMAGE=... --build-arg BASE_TAG=...
# (see docs/image.md). Bump BASE_TAG when moving to the next Fedora release.
BASE_IMAGE=quay.io/fedora-ostree-desktops/kinoite
BASE_TAG=44
