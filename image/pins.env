# Redrob OS downloaded-artifact pins.
#
# Every file the image build fetches from the network is listed here with a
# version, an exact URL and a checksum. Build scripts in image/scripts/ source
# this file and refuse to install anything whose checksum does not match.
#
# Format (shell syntax, one assignment per line, no spaces around `=`):
#   <NAME>_VERSION=<upstream version or release tag>
#   <NAME>_URL=<exact download URL; may use ${ARCH} (x86_64|aarch64)>
#   <NAME>_SHA256=<hex>      or   <NAME>_SHA512=<hex>
#   per-arch checksums are suffixed with the arch: <NAME>_SHA512_X86_64=, <NAME>_SHA512_AARCH64=
# A value of `TODO-hash` means the download failed when the pin was written; the
# build fails until a real hash is filled in.
#
# To bump a pin: download the new artifact into $KIROCREW_SCRATCH with `curl -L`,
# run `sha256sum`/`sha512sum`, update VERSION + URL + hash together in one commit
# (`feat(bootc): bump <name> to <version>`). docs/image.md has the procedure.
#
# Other agents/owners append their own sections below (agent runtime, model
# runner, installer assets...). Keep one blank line and a `# --- <owner> ---`
# comment between sections.

# --- base OS (image agent) ---

# gVisor: application-kernel sandbox used as the podman runtime `runsc` for
# agent tasks. Upstream publishes one tar.zstd per arch containing runsc,
# containerd-shim-runsc-v1 and the gvisor-bin/ sidecar binaries that runsc
# requires next to itself. `latest/` is a moving alias; we pin the dated release.
GVISOR_VERSION=20261012.0
GVISOR_URL=https://storage.googleapis.com/gvisor/releases/release/${GVISOR_VERSION}/${ARCH}/gvisor.tar.zstd
GVISOR_SHA512_X86_64=ce2e1aeb853c104e854dea6644333a1dba0fbc9dd1646af97e1d013fdf810da6d4176dd96f2139d7b055e5382117c0d7c4567ebd64ed9bef47fdd15f80fd67ab
GVISOR_SHA512_AARCH64=3459ca3e496465e5b6a1318563ede4bb079bdf11ae93f4bb8d71df3cd2f19bfa6db7c1035d2f9e97b4f4e57c298a4f18b42af7297c048ec7e14ec819223684e4

# Redrob Launcher: installs/updates the Redrob desktop apps into the user's home.
# Linux release tarball layout: <name>-<ver>-linux-<arch>/{bin/redrob-launcher,
# share/applications/ai.redrob.launcher.desktop, share/icons/hicolor/..., share/metainfo/...}
REDROB_LAUNCHER_VERSION=0.7.0
REDROB_LAUNCHER_URL=https://github.com/redrob-labs/redrob-launcher/releases/download/v${REDROB_LAUNCHER_VERSION}/redrob-launcher-${REDROB_LAUNCHER_VERSION}-linux-${ARCH}.tar.gz
REDROB_LAUNCHER_SHA256_X86_64=c573807b60badcfe52ada38d67c538189d4b50a4722190e11d9982eabc1821d9
REDROB_LAUNCHER_SHA256_AARCH64=d8e553db054860393262fc5114ce02f5cbf2631c3925be053eb750a344188f71

# --- task sandbox image (image/sandbox/Containerfile) ---

# Redrob Code: headless coding tool the agent runs inside the task sandbox.
# Linux release tarball layout: <name>-<ver>-linux-<arch>/bin/{redrob,redrob-code}
REDROB_CODE_VERSION=0.8.0
REDROB_CODE_URL=https://github.com/redrob-labs/redrob-code/releases/download/v${REDROB_CODE_VERSION}/redrob-code-${REDROB_CODE_VERSION}-linux-${ARCH}.tar.gz
REDROB_CODE_SHA256_X86_64=d366f29deaf331ad53ea7fb6c6b1060bde01c712ff8d11382896b54a75e3d6b9
REDROB_CODE_SHA256_AARCH64=9425c9d7ce50961e49f9f88bf64b3bbb5416f5fce01430e15254597c125ba223

# --- UI typefaces (branding) ---

# Redrob Group Design System 30-typography.md: Pretendard (Latin system face) and
# Wanted Sans (Korean system face). Both SIL OFL 1.1. Static OTFs are installed by
# image/scripts/25-fonts.sh; the zips are the upstream GitHub release assets.
PRETENDARD_VERSION=1.3.9
PRETENDARD_URL=https://github.com/orioncactus/pretendard/releases/download/v${PRETENDARD_VERSION}/Pretendard-${PRETENDARD_VERSION}.zip
PRETENDARD_SHA256=04be351a74d6bf7d60c480a3087e51d185485d35a52023142af1df19eb8c428a
WANTED_SANS_VERSION=1.0.3
WANTED_SANS_URL=https://github.com/wanteddev/wanted-sans/releases/download/v${WANTED_SANS_VERSION}/WantedSans-${WANTED_SANS_VERSION}.zip
WANTED_SANS_SHA256=e0734c1e29426d2a6213650383fec37051145fccaed8360c8fe30d75321d98ab

